# 移植の原典にする Apache Pekko の基準（正）。シェルは source し、Python は
# ledger/tools/pekko_baseline.py が KEY=VALUE として読む。値に空白や引用符は使わない。
# 決定の経緯は docs/baseline/README.md にある。

# 現行の基準。2026-11-25 のオーナー決定で v1.7.1 から切り替えた。
# PEKKO_BASELINE_COMMIT はタグが指す commit（注釈付きタグを剥いた値）、
# PEKKO_BASELINE_TAG_OBJECT はタグ object そのもの。どちらも 2026-11-25 に
# git ls-remote --tags https://github.com/apache/pekko で確認した。
PEKKO_BASELINE_TAG=v2.0.0
PEKKO_BASELINE_COMMIT=9fbd2283b1cf701c90a1223bf621942c191db61f
PEKKO_BASELINE_TAG_OBJECT=879512455865e4a81433c8c96fd11c2b95c5bd7d
PEKKO_BASELINE_DECIDED_AT=2026-11-25

# 過去の基準（履歴）。台帳の verified_against に残る照合済みタグを、ここで commit と
# 対応づける。カンマ区切りの <タグ>:<commit>（空白は使わない。シェルが 2 項目目をコマンドとして実行する）。現役の経路はこの値で原典を準備しない。
PEKKO_HISTORICAL_BASELINES=v1.7.1:9a54d1294c3ac7821bbed3c940769c3d5027d1ff
